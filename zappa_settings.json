{
    "dev": {
        "app_function": "cloudome.app",
        "exclude": [
            "boto3",
            "dateutil",
            "botocore",
            "s3transfer",
            "concurrent"
        ],
        "profile_name": "bossdb",
        "project_name": "cloudome",
        "aws_region": "us-east-1",
        "runtime": "python3.11",
        "s3_bucket": "zappa-cloudome-function",
        "events": [
            {
                "function": "cloudome.process_queue_job",
                "event_source": {
                    "arn": "arn:aws:sqs:us-east-1:407510763690:CloudomeJobs",
                    "batch_size": 10,
                    "enabled": true
                }
            }
        ]
    }
}